# ─── Arbiter Frontend — Environment Variables ────────────────────────────────
# Copy this file to .env.local for local development.
# In production (Render), set these as environment variables in the dashboard.
# Variables prefixed with VITE_ are embedded into the built JS bundle at build time.

# ── Backend API URL ────────────────────────────────────────────────────────────
# URL of the deployed Arbiter backend service.
# Leave empty for local dev (vite.config.js will proxy to localhost:8000).
# Example: https://arbiter-backend.onrender.com
VITE_API_URL=

# ── Firebase Configuration ────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
