# Environment variables for Arbiter
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ── Jira (Atlassian Rovo MCP) ──────────────────────────────────────────────────
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Slack ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Google Cloud / Vertex AI ───────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Storage (defaults shown; override if needed) ───────────────────────────────
CHROMA_PATH=./chroma_data
DATABASE_URL=sqlite:///./arbiter.db

# ── Trust scoring ──────────────────────────────────────────────────────────────
TRUST_THRESHOLD=0.75
COLD_START_SUCCESS_RATE=0.3
COLD_START_MIN_SAMPLES=20

# ── Scoring weights (must sum to 1.0) ──────────────────────────────────────────
WEIGHT_RETRIEVAL=0.40
WEIGHT_CATEGORY=0.35
WEIGHT_LLM_CONFIDENCE=0.25
